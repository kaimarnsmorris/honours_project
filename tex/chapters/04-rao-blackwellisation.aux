\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Training curves across parameter dimension $p \in \{2, 5, 10, 20, 30\}$ (rows) and batch size $\{4, 16, 64, 256\}$ (columns), at sample size $n = 50$ under the precision prior $\tau = \sigma ^{-2} \sim \mathrm  {Uniform}(0.01, 1)$ (equivalently $\sigma \in (1, 10)$). Each panel shows the mean over seeds with a $\pm 1$ standard-deviation band --- Monte Carlo (MC) in blue, Rao-Blackwellised (RB) in orange. The dark green dashed line in each panel marks the Bayes-optimal floor $L^{*}(p)$ for that dimension. RB tracks at or below MC in every panel, at every batch size, and nearer the floor.}}{34}{figure.caption.20}\protected@file@percent }
\newlabel{fig:curves}{{4.1}{34}{Training curves across parameter dimension $p \in \{2, 5, 10, 20, 30\}$ (rows) and batch size $\{4, 16, 64, 256\}$ (columns), at sample size $n = 50$ under the precision prior $\tau = \sigma ^{-2} \sim \Uniform (0.01, 1)$ (equivalently $\sigma \in (1, 10)$). Each panel shows the mean over seeds with a $\pm 1$ standard-deviation band --- Monte Carlo (MC) in blue, Rao-Blackwellised (RB) in orange. The dark green dashed line in each panel marks the Bayes-optimal floor $L^{*}(p)$ for that dimension. RB tracks at or below MC in every panel, at every batch size, and nearer the floor}{figure.caption.20}{}}
\MT@newlabel{eq:lr-trace-spectrum}
