\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces The DeepSets architecture for permutation-invariant estimation. Each observation $y_i$ is mapped by the shared network $\psi $ to an embedding $s_i$; the embeddings are summed into the permutation-invariant aggregate $S = \DOTSB \sum@ \slimits@ _i \psi (y_i)$, which the second network $\phi $ maps to the estimate $\hat  {\bm  {\theta }}(\mathbf  {y})$.}}{22}{figure.caption.14}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:deepsets}{{3.1}{22}{The DeepSets architecture for permutation-invariant estimation. Each observation $y_i$ is mapped by the shared network $\psi $ to an embedding $s_i$; the embeddings are summed into the permutation-invariant aggregate $S = \sum _i \psi (y_i)$, which the second network $\phi $ maps to the estimate $\hat {\bm {\theta }}(\mathbf {y})$}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3.2}Recurrent architectures for sequential data}{22}{subsection.3.3.2}\protected@file@percent }
\newlabel{sec:recurrent-arch}{{3.3.2}{22}{Recurrent architectures for sequential data}{subsection.3.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces A recurrent architecture for sequential data, unrolled over the sequence. At step $t$ the shared cell $\psi $ combines the observation $y_t$ with the previous hidden state $\mathbf  {h}_{t-1}$ to produce $\mathbf  {h}_t$; the final map $\phi $ turns the terminal hidden state $\mathbf  {h}_n$ into the estimate $\hat  {\bm  {\theta }}(\mathbf  {y})$.}}{23}{figure.caption.15}\protected@file@percent }
\newlabel{fig:recurrent}{{3.2}{23}{A recurrent architecture for sequential data, unrolled over the sequence. At step $t$ the shared cell $\psi $ combines the observation $y_t$ with the previous hidden state $\mathbf {h}_{t-1}$ to produce $\mathbf {h}_t$; the final map $\phi $ turns the terminal hidden state $\mathbf {h}_n$ into the estimate $\hat {\bm {\theta }}(\mathbf {y})$}{figure.caption.15}{}}
