\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Estimated against true parameter values for the normal model, across $256$ test datasets, for Metropolis--Hastings and the neural Bayes estimator. Both methods track the true parameters closely; the dashed line marks the hypothetical perfect estimation.}}{24}{figure.caption.16}\protected@file@percent }
\newlabel{fig:normal-model}{{3.3}{24}{Estimated against true parameter values for the normal model, across $256$ test datasets, for Metropolis--Hastings and the neural Bayes estimator. Both methods track the true parameters closely; the dashed line marks the hypothetical perfect estimation}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Normal model: accuracy (mean squared error over the $256$ test datasets) and per-dataset cost of the Metropolis--Hastings reference and the neural Bayes estimator. The two agree closely in accuracy, but the amortised network is faster per dataset by some three orders of magnitude (single-threaded CPU timing; $5{,}000$-step chains for Metropolis--Hastings).}}{24}{table.caption.17}\protected@file@percent }
\newlabel{tab:normal-model}{{3.1}{24}{Normal model: accuracy (mean squared error over the $256$ test datasets) and per-dataset cost of the Metropolis--Hastings reference and the neural Bayes estimator. The two agree closely in accuracy, but the amortised network is faster per dataset by some three orders of magnitude (single-threaded CPU timing; $5{,}000$-step chains for Metropolis--Hastings)}{table.caption.17}{}}
